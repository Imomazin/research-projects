{
  "version": "revised dictionary after AI-assisted precision audit of the frozen original (see Analysis Plan deviations)",
  "notes": "Regular expressions applied case-insensitively at sentence level with word boundaries. A sentence is assigned to every category whose pattern matches. Terms were chosen from the category definitions in the research design before any outcome data were examined. Revised once after the precision audit: economic-sanctions phrasing replaces bare 'sanctions'; supplier terms require dependency or disruption context; ESG investor-attention terms removed from climate; company abbreviations and 'automation' removed from technology; broader regulatory-change and IT-disruption phrasing added; action sentences exclude negations, passive observations and self-descriptions.",
  "categories": {
    "geopolitical": {
      "label": "Geopolitical conflict and instability",
      "patterns": [
        "geopolitic\\w*",
        "\\bwars?\\b",
        "warfare",
        "armed conflicts?",
        "military (?:conflicts?|action|actions|hostilities|operations)",
        "hostilities",
        "invasion",
        "terroris\\w*",
        "embargo\\w*",
        "political (?:instability|unrest|turmoil|crisis|crises)",
        "civil unrest",
        "\\bcoups?\\b",
        "russia\\w*",
        "ukrain\\w*",
        "\\bisrael\\w*",
        "\\bgaza\\b",
        "\\bhamas\\b",
        "red sea",
        "taiwan strait",
        "cross-strait",
        "north korea\\w*",
        "regional conflicts?",
        "international conflicts?",
        "acts of war",
        "(?:economic|trade|international|financial|export|u\\.s\\.|us|eu|western|ofac|government) sanctions",
        "sanctions (?:against|on|imposed on|targeting|relating to) (?:russia|iran|china|venezuela|north korea|certain countries|countries)",
        "sanctioned (?:countries|country|persons|entities|regions|jurisdictions|parties)",
        "\\bofac\\b",
        "sanctions regimes?",
        "sanctions programs?"
      ]
    },
    "trade": {
      "label": "Trade policy and protectionism",
      "patterns": [
        "tariffs?",
        "trade wars?",
        "trade (?:disputes?|tensions?|polic\\w+|restrictions?|barriers?|protection\\w*|frictions?|agreements?)",
        "protectionis\\w*",
        "import (?:duties|duty|restrictions?|quotas?)",
        "customs duties",
        "export controls?",
        "export restrictions?",
        "entity list",
        "section 301",
        "retaliatory",
        "anti-dumping",
        "countervailing dut\\w+",
        "usmca",
        "\\bnafta\\b"
      ]
    },
    "regulatory": {
      "label": "Regulatory and policy change",
      "patterns": [
        "changes? (?:in|to) (?:the )?(?:applicable )?(?:laws?|regulations?|regulatory|legislation|government polic\\w+|tax laws?|tax rates?|accounting standards)",
        "new (?:laws?|regulations?|legislation|regulatory requirements?)",
        "regulatory (?:uncertainty|changes?|developments?|reforms?|environment is changing|scrutiny)",
        "legislative (?:changes?|proposals?|action|reforms?|developments?)",
        "policy uncertainty",
        "government shutdowns?",
        "tax reform",
        "tax cuts and jobs act",
        "inflation reduction act",
        "chips and science act",
        "executive orders?",
        "changes? in (?:u\\.s\\. |us |federal |government )?(?:trade |fiscal |monetary |economic )?polic\\w+",
        "change in administration",
        "presidential administration",
        "changes? (?:in|to) (?:\\w+ ){0,2}(?:laws?|regulations?|legislation|polic(?:y|ies))",
        "new (?:or (?:additional|amended|changed|increasingly stringent|modified) )?(?:laws?|regulations?|rules)",
        "digital services tax\\w*",
        "(?:laws?|regulations?) (?:may|could) (?:change|be (?:changed|amended|enacted|adopted))"
      ]
    },
    "cyber": {
      "label": "Cybersecurity and digital infrastructure",
      "patterns": [
        "cyber\\w*",
        "data breach\\w*",
        "security breach\\w*",
        "breaches of (?:our )?(?:information|security|data|systems?)",
        "ransomware",
        "malware",
        "\\bhack\\w*",
        "phishing",
        "unauthori[sz]ed access",
        "denial[- ]of[- ]service",
        "computer viruses",
        "information security",
        "security incidents?",
        "network intrusions?",
        "system (?:failures?|outages?|interruptions?)",
        "it (?:systems?|infrastructure) (?:failures?|outages?|disruptions?)",
        "(?:disruptions?|failures?|breakdowns?|interruptions?|outages?) (?:of|in|to) (?:our )?(?:it|information technology|information|computer|technology) systems"
      ]
    },
    "technology": {
      "label": "Artificial intelligence and technological disruption",
      "patterns": [
        "artificial intelligence",
        "machine learning",
        "generative ai",
        "large language models?",
        "\\bgenai\\b",
        "disruptive technolog\\w+",
        "technological disruption",
        "rapid(?:ly)? (?:changing|evolving) technolog\\w*",
        "emerging technolog\\w+",
        "new technolog\\w+ (?:could|may|might) (?:render|make)",
        "technological obsolescence",
        "digital transformation",
        "new entrants? (?:with|using) (?:new )?technolog\\w+",
        "technologically obsolete",
        "obsolete (?:technolog\\w*|products?|services?)",
        "render (?:our |their )?(?:products?|services?|technolog\\w*|offerings?) (?:\\w+ )?obsolete",
        "technological (?:change|changes|developments|advances)",
        "(?-i:\\bAI\\b)",
        "artificial intelligence"
      ]
    },
    "supply": {
      "label": "Supply-chain disruption",
      "patterns": [
        "supply chains?",
        "sole[- ]source\\w*",
        "single[- ]source\\w*",
        "limited number of (?:suppliers|sources|vendors|manufacturers)",
        "sourcing",
        "shortages?",
        "logistics",
        "shipping (?:delays?|disruptions?|costs?|capacity)",
        "freight",
        "port (?:congestion|closures?|delays?)",
        "raw materials?",
        "semiconductor shortage",
        "supply disruptions?",
        "disruptions? (?:in|to|of) (?:our )?(?:supply|deliveries|delivery|production|manufacturing|distribution)",
        "availability of (?:raw materials|components|parts|inputs)",
        "components? (?:shortages?|supply|availability|suppliers?|constraints?)",
        "(?:supply|availability|shortages?) of (?:\\w+ ){0,2}components?",
        "(?:rely|relies|reliance|depend|depends|dependent|dependence) (?:up)?on (?:\\w+ ){0,4}(?:suppliers?|vendors|contract manufacturers?|third[- ]party manufacturers?|sole[- ]source)",
        "(?:key|critical|sole|single|limited number of|principal|major) suppliers?",
        "suppliers? (?:fail\\w*|disrupt\\w*|delay\\w*|shortages?|unable|capacity|concentration|financial difficult\\w*|may not|could not|cannot)",
        "loss of (?:a |any |one or more |key )?(?:significant |major )?(?:suppliers?|vendors)",
        "(?:alternative|alternate|additional|new) suppliers?",
        "supplier (?:base|diversification|concentration)",
        "inability (?:of|by) (?:our )?(?:suppliers?|contract manufacturers?)"
      ]
    },
    "climate": {
      "label": "Climate and environmental change",
      "patterns": [
        "climate change",
        "climate-related",
        "climate risks?",
        "global warming",
        "extreme weather",
        "severe weather",
        "weather events?",
        "greenhouse gas\\w*",
        "carbon (?:emissions?|tax\\w*|pricing|price|dioxide|neutral\\w*|footprint)",
        "emissions? reductions?",
        "net[- ]zero",
        "hurricanes?",
        "wildfires?",
        "\\bfloods?\\b",
        "flooding",
        "droughts?",
        "sea levels?",
        "natural disasters?",
        "water scarcity",
        "physical risks? of climate",
        "transition (?:to a )?low[- ]carbon",
        "adverse weather",
        "weather conditions",
        "climate (?:disclosure|regulation)\\w*"
      ]
    },
    "macro": {
      "label": "Macroeconomic and financial instability",
      "patterns": [
        "inflation\\w*",
        "interest rates?",
        "recessions?",
        "recessionary",
        "currency (?:fluctuations?|exchange|risks?|volatility)",
        "foreign (?:currency|exchange)",
        "exchange rates?",
        "credit markets?",
        "capital markets? (?:volatility|disruptions?|conditions)",
        "financial (?:crisis|crises|markets? volatility|instability)",
        "banking (?:crisis|crises|system)",
        "bank failures?",
        "liquidity (?:constraints?|crisis)",
        "deflation\\w*",
        "stagflation",
        "unemployment",
        "consumer (?:spending|confidence)",
        "commodity prices?",
        "energy prices?",
        "fuel prices?",
        "economic (?:downturns?|slowdowns?|uncertainty|instability|crisis|crises|weakness)",
        "(?:adverse|weak|weaker|poor|unfavou?rable|uncertain|volatile|deteriorating|negative) (?:global |general |macro)?economic conditions",
        "deteriorat\\w+ (?:in |of )?(?:global |general )?economic conditions",
        "macroeconomic",
        "(?:pounds sterling|euros?|renminbi|yen) (?:exchange|exposure|denominated)"
      ]
    },
    "pandemic": {
      "label": "Pandemic and public-health crises",
      "patterns": [
        "pandemics?",
        "epidemics?",
        "covid\\w*",
        "coronavirus\\w*",
        "sars-cov-2",
        "outbreaks?",
        "public health (?:crisis|crises|emergenc\\w+|threats?|concerns?|issues?)",
        "\\bsars\\b",
        "\\bh1n1\\b",
        "influenza",
        "contagious diseases?",
        "infectious diseases?",
        "\\bmpox\\b",
        "monkeypox",
        "quarantines?",
        "lockdowns?",
        "shelter[- ]in[- ]place"
      ]
    }
  },
  "action_sentence": {
    "notes": "A documented response sentence has a first-person organisational subject, a realised action verb, a category term within twelve words of that verb, no conditional modal and no accounting-treatment vocabulary. Applied to Items 1 and 7.",
    "subject": "\\b(?:we|our company|the company|our management|management)\\b",
    "verbs": [
      "implemented",
      "invested",
      "expanded",
      "diversified",
      "relocated",
      "reshored",
      "nearshored",
      "onshored",
      "added",
      "acquired",
      "restructured",
      "launched",
      "deployed",
      "upgraded",
      "established",
      "built",
      "secured",
      "qualified",
      "entered into",
      "adopted",
      "enhanced",
      "strengthened",
      "developed",
      "introduced",
      "hedged",
      "renegotiated",
      "consolidated",
      "shifted",
      "transitioned",
      "exited",
      "divested",
      "streamlined",
      "accelerated",
      "automated",
      "increased our inventor\\w*",
      "increased inventor\\w*",
      "built (?:up )?inventor\\w*",
      "moved production",
      "dual[- ]sourc\\w+",
      "migrated",
      "have (?:taken|implemented|invested|expanded|diversified|established|enhanced|strengthened|deployed|adopted|developed|launched)",
      "are (?:implementing|investing|expanding|diversifying|deploying|developing|enhancing|strengthening)",
      "initiated",
      "completed"
    ],
    "exclude_modals": "\\b(?:may|might|could|would|should|if|cannot|can not|unable|not|no|never|began to (?:see|experience|feel))\\b",
    "proximity_words": 12,
    "exclude_accounting": "\\b(?:accounting for|recogni[sz]ed|recorded|impairment|amorti[sz]ation|depreciation|fair value|provision for|deferred tax|effective tax rate)\\b",
    "exclude_self_description": "\\b(?:we are|the company is|is) (?:a|an|the|one of the) (?:\\w+ ){0,5}(?:supplier|provider|manufacturer|distributor)\\b"
  },
  "hazard_catalogue_threshold": 4
}